{
  "name": "dsh-deepseek-quota-left",
  "version": "0.5.0",
  "description": "DeepSeek API quota widget for the dsh web GUI — left-edge collapsed handle, click to expand; official balance, today's consumption and conversation cost. Fork of dsh-deepseek-quota.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "quota",
    "balance",
    "web"
  ],
  "license": "MIT"
}
